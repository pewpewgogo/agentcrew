{
  "name": "agentcrew",
  "version": "0.1.0",
  "description": "Task manager and context sync for AI agents and the humans operating them. Hosted REST + MCP server, CLI, and Claude skill.",
  "type": "module",
  "bin": { "agentcrew": "dist/cli/index.js", "ac": "dist/cli/index.js" },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && cp -r src/skill-template dist/",
    "dev:server": "tsx watch src/server/index.ts",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": ["mcp", "ai", "agents", "claude", "task-manager", "context", "cli"],
  "license": "MIT",
  "author": "Vladimir Plotvinov",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "argon2": "^0.40.0",
    "commander": "^12.0.0",
    "fastify": "^4.26.0",
    "@fastify/cors": "^9.0.0",
    "pg": "^8.11.0",
    "zod": "^3.22.0",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/pg": "^8.10.0",
    "@types/prompts": "^2.4.0",
    "pg-mem": "^2.8.0",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  },
  "engines": { "node": ">=20" }
}
